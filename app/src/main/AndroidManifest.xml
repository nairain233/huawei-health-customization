<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <!-- UI 只在宿主窗口运行，不让传递依赖增加模块进程的自动初始化入口。 -->
        <!-- 以下是合并删除标记，不是模块实现的组件，限定忽略 IDE 的类解析检查。 -->
        <!--suppress AndroidDomInspection -->
        <provider android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" tools:ignore="MissingClass" />
        <!--suppress AndroidDomInspection -->
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass" />
    </application>
</manifest>
