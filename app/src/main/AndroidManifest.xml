<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.huawei.health" />
    </queries>

    <application
        android:name=".app.ModuleApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.华为运动精简">
        <!-- call() 校验 Binder UID，仅接收脱敏报告；不提供数据查询或配置写入。 -->
        <provider
            android:name=".scan.ScanReportProvider"
            android:authorities="love.nairain.huawei.scan"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <activity
            android:name=".app.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity
            android:name=".app.CategorySettingsActivity"
            android:exported="false" />
        <activity
            android:name=".app.LayoutTrimActivity"
            android:exported="false" />
        <activity
            android:name=".app.ServiceBlockActivity"
            android:exported="false" />
        <activity
            android:name=".app.ThemeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".app.AboutActivity"
            android:exported="false" />
        <activity-alias
            android:name=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".app.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
    </application>

</manifest>
